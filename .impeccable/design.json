      "css": ".ds-field{display:grid;gap:7px;font-family:var(--f-body,\"Geist\",\"Segoe UI\",sans-serif);font-size:.8rem;font-weight:550;color:var(--muted,#babcc8)}.ds-field input{font-family:var(--f-body,\"Geist\",\"Segoe UI\",sans-serif);min-height:44px;padding:10px 12px;border:1px solid var(--line,#41454f);border-radius:9px;background:var(--bg,#191a1e);color:var(--fg,#f4f2ed);font-size:.875rem;font-weight:400}.ds-field input::placeholder{color:var(--muted,#babcc8);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--petal,#d8d3ff);outline-offset:3px}"
    },
