  "components": [
    {
      "name": "Principal lavanda",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal; --paper cambia a lavanda profunda en Claro.",
      "html": "<button class=\"ds-primary\">Guardar pedido</button>",
      "css": ".ds-primary{font-family:var(--f-body,\"Geist\",\"Segoe UI\",sans-serif);min-height:46px;padding:9px 14px;border-radius:9px;font-size:.82rem;font-weight:500;line-height:1.35;cursor:pointer;background:var(--paper,#c7c2ff);border:1px solid var(--paper,#c7c2ff);color:var(--paper-ink,#242138)}.ds-primary:hover{filter:brightness(.95)}.ds-primary:focus-visible{outline:3px solid var(--petal,#d8d3ff);outline-offset:3px}.ds-primary:disabled{opacity:.6;cursor:default}"
