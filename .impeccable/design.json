      "css": ".ds-nav{display:flex;gap:24px;border-bottom:1px solid var(--line,#41454f)}.ds-nav button{font-family:var(--f-body,\"Geist\",\"Segoe UI\",sans-serif);min-height:52px;padding:0 10px;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted,#babcc8);font-size:.88rem;cursor:pointer}.ds-nav button[aria-pressed=true]{border-bottom-color:var(--paper,#c7c2ff);color:var(--fg,#f4f2ed)}.ds-nav button:focus-visible{outline:3px solid var(--petal,#d8d3ff);outline-offset:3px}"
